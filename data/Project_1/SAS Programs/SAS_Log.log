831
832
833
834  *********************************************************
835  *  CALCULATING SUMMARY SCORES BASED ON WEIGHTED AVERAGE *
836  * 1) fixed standard weights from CMS                    *
837  * 2) redistribute weights when there is missing group   *
838  *                                                       *
839  *********************************************************;
840
841  data summary_score (drop=I1-I5 w1-w5 grp_score1-grp_score5 k sum_weight_ave1-sum_weight_ave5);
842      set all;
843
844      array std_weight(5) std_weight_PatientExperience std_weight_Readmission std_weight_Mortality
844! std_weight_safety
845                         std_weight_Process;
846
847      array w(5) w1-w5;
848
849      array weight(5) weight_PatientExperience weight_Outcomes_Readmission
849! weight_Outcomes_Mortality
850                      weight_Outcomes_Safety weight_Process;
851
852      array score(5)   Std_PatientExp_score Std_Outcomes_Readmission_score
852! Std_Outcomes_Mortality_score
853                      Std_Outcomes_Safety_score Std_Process_score;
854
855      array grp_score(5) grp_score1-grp_score5;
856
857      array I(5) I1 I2 I3 I4 I5 ;
858
859      array sum_weight_ave(5) sum_weight_ave1 sum_weight_ave2 sum_weight_ave3 sum_weight_ave4
860                              sum_weight_ave5;
861
862
863      /* fixed standard weights from CMS */;
864      std_weight_PatientExperience = 0.22;
865      std_weight_Readmission = 0.22;
866      std_weight_Mortality = 0.22;
867      std_weight_safety = 0.22;
868      std_weight_Process = 0.12;
869
870      /* create indicator for missing group*/
871      do k=1 to 5;
872      w[k]= std_weight[k];
873      grp_score[k]=score[k];
874
875      if grp_score[k] =. then I[k]=1;
876         else I[k]=0;
877      end;
878
879      /* Redistribute weights when there is missing group. For details, please refer to technical
879! report. */
880      /*For example, the group of Safety is missing, the weight for Mortality groups is changed
881      from 22/100 to 22/78, the weight for Timely and Effective Care is changed from 12/100 to
881! 12/78.*/
882      do k=1 to 5;
883      if grp_score[k] =. then weight[k]=.;
884         else weight[k]=W[k]/(1-I1*W1-I2*W2-I3*W3-I4*W4-I5*W5);
885      end;
886
887      do k=1 to 5;
888      if weight[k] =. then sum_weight_ave[k]=0;
889          else sum_weight_ave[k]=weight[k]*score[k];
890      end;
891
892      /* summary scores */
893      summary_score = sum (of sum_weight_ave1-sum_weight_ave5);
894  run;

