815
816  /*This program is used to derive the hospital stars. The summary
817    score of each hospital is calculated based on the hospital's
818    group(domain) scores which are output from program 1. Then
819    the K-means approach is used to derive the hospital star ratings.
820  */
821
822  /* put all group scores into one file */
823  data all;
824      merge  R.Outcome_mortality(keep=provider_id grp_score rename
824! =grp_score=Std_Outcomes_Mortality_score)
825             R.Outcome_readmission(keep = provider_id grp_score rename =
825! grp_score=Std_Outcomes_Readmission_score)
826             R.Outcome_safety(keep=provider_id grp_score rename
826! =grp_score=Std_Outcomes_Safety_score)
827             R.Ptexp(keep = provider_id grp_score rename = grp_score=Std_PatientExp_score)
828             R.Process(keep=provider_id grp_score rename = grp_score=Std_Process_score);
829      by provider_id;
830  run;

