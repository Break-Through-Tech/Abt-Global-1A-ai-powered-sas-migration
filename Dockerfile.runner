FROM python:3.11-slim AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /build

COPY pyproject.toml README.md ./
COPY src ./src

RUN python -m pip install --upgrade pip \
    && python -m pip wheel --no-deps --wheel-dir /wheels .


FROM python:3.11-slim

ENV HOME=/nonexistent \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN groupadd --gid 65532 runner \
    && useradd --uid 65532 --gid 65532 --no-create-home --home-dir /nonexistent \
        --shell /usr/sbin/nologin runner

COPY --from=builder /wheels /wheels
RUN python -m pip install --upgrade pip \
    && python -m pip install /wheels/sasguard-*.whl \
    && rm -rf /wheels

WORKDIR /runner/source

USER 65532:65532

ENTRYPOINT ["python", "-m", "sasguard.execution.worker"]
